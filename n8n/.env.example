# Copy to n8n/.env and fill in. This file is the only place the secrets live
# on the n8n side.

# Encrypts n8n's own credential store. Any long random string.
N8N_ENCRYPTION_KEY=

# Public URL n8n should advertise for webhooks (your tunnel or domain).
WEBHOOK_URL=http://localhost:5678/

# Convex -> n8n: Convex signs the request-notification webhook with this.
# Must match N8N_WEBHOOK_SECRET on the Convex deployment.
LENDLOOP_WEBHOOK_SECRET=

# n8n -> Convex: n8n signs calls to the Convex HTTP endpoints with this.
# Must match CONVEX_AUTOMATION_SECRET on the Convex deployment.
LENDLOOP_CONVEX_SECRET=

# Your deployment's HTTP actions URL, e.g. https://happy-otter-123.convex.site
LENDLOOP_CONVEX_SITE_URL=
