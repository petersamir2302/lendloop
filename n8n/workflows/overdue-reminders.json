{
  "id": "LLremind0000001",
  "name": "LendLoop: overdue reminders",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LLerrors0000001",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f01",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f00",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        480
      ],
      "parameters": {}
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f02",
      "name": "Sign overdue query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = '{}';\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.LENDLOOP_CONVEX_SECRET).update(`${ts}.${body}`).digest('hex');\nreturn [{ json: { url: `${$env.LENDLOOP_CONVEX_SITE_URL}/automation/overdue-loans`, body, ts, signature } }];"
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f03",
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f04",
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "const loans = $input.first().json.loans || [];\nreturn loans.map((loan) => ({ json: loan }));"
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f05",
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Replace with Send Email / Slack. Only first name, email, tool and dates come in.\nconst l = $json;\nconst days = l.daysOverdue === 1 ? '1 day' : `${l.daysOverdue} days`;\nconst message = `Hi ${l.borrower.firstName}, the ${l.toolName} was due back on ${l.endDate} (${days} ago). Please return it or message the owner.`;\nconsole.log(`[lendloop] remind ${l.borrower.email}: ${message}`);\nreturn { json: { loanId: l.loanId, reminderKey: l.reminderKey, status: 'sent' } };"
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f06",
      "name": "Sign status update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst body = JSON.stringify({ reminderKey: $json.reminderKey, loanId: $json.loanId, status: $json.status });\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.LENDLOOP_CONVEX_SECRET).update(`${ts}.${body}`).digest('hex');\nreturn { json: { url: `${$env.LENDLOOP_CONVEX_SITE_URL}/automation/reminder-status`, body, ts, signature } };"
      }
    },
    {
      "id": "7c2a1b3f-2d22-4b1a-8d4f-1b2c3d4e5f07",
      "name": "Write status to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue query": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock)": {
      "main": [
        [
          {
            "node": "Sign status update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign status update": {
      "main": [
        [
          {
            "node": "Write status to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
